---
// @ts-ignore: Astro resolves this component at build time.

import Layout from "../layouts/Layout.astro";
---

<Layout title="AstroCarlZ · Astrología y Numerología">
  <main class="min-h-screen flex items-center justify-center text-center px-6">
    <div>
      <h1 class="font-serif text-6xl md:text-8xl text-dorado tracking-elegant mb-4">
        AstroCarlZ
      </h1>
      <p class="font-serif text-2xl md:text-3xl text-crema mb-4">
        Astrología y Numerología
      </p>
      <p class="font-sans text-sm text-tinta-soft tracking-wide">
        Más de 40 años de experiencia
      </p>
    </div>
  </main>
</Layout>