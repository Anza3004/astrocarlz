---
import "../styles/global.css";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";


interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Astrología y Numerología con más de 40 años de experiencia. Cartas natales, numerología y consultas personalizadas.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <!-- Vercel Analytics -->
<script defer src="/_vercel/insights/script.js"></script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    {/* SEO */}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="AstroCarlZ" />
<meta name="google-site-verification" content="ovM14xTyJmbtEUI-2Iq8fHgXEOb44-AIUyeIk6QUMo8" />

    {/* Open Graph para redes sociales */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

            {/* Schema.org LocalBusiness para SEO */}
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "AstroCarlZ",
        "alternateName": "Astro CarlZ",
        "description": "Astrología y numerología con más de 40 años de experiencia. Cartas natales, numerología y consultas personalizadas.",
        "url": "https://astrocarlz.vercel.app",
        "telephone": "+526861614063",
        "priceRange": "$400 - $1,800 MXN",
        "areaServed": {
          "@type": "Country",
          "name": "México"
        },
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Mexicali",
          "addressRegion": "Baja California",
          "addressCountry": "MX"
        },
        "hasOfferCatalog": {
          "@type": "OfferCatalog",
          "name": "Servicios de AstroCarlZ",
          "itemListElement": [
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Numerología Esencial",
                "description": "Estudio numerológico personal: camino de vida, números de alma y personalidad."
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Carta Esencial",
                "description": "Carta natal escrita de 15 a 20 páginas: Sol, Luna, Ascendente, planetas, casas y aspectos principales."
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Consulta en vivo",
                "description": "Sesión de 60 minutos, sin informe escrito."
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Carta Completa",
                "description": "Informe de 30+ páginas con nodos lunares, Quirón y análisis de aspectos a fondo."
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Carta + Sesión",
                "description": "Carta Completa y videollamada de 45 a 60 minutos para explicarla y resolver dudas."
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Paquete Integral",
                "description": "Carta Completa, tránsitos del año, sesión de 60 minutos y seguimiento a los 3 meses."
              }
            }
          ]
        },
        "sameAs": [
          "https://www.facebook.com/astroynumerologo"
        ],
        "founder": {
          "@type": "Person",
          "name": "AstroCarlZ",
          "jobTitle": "Astrólogo y Numerólogo",
          "description": "Más de 40 años de experiencia interpretando el lenguaje de los astros."
        },
        "knowsLanguage": ["es"],
        "slogan": "Lecturas personalizadas del cielo"
      })}
    />

    {/* Fuentes */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Navbar />
    <slot />
    <Footer />
    </body>
</html>