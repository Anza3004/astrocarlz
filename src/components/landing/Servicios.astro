---
// Servicios de AstroCarlZ
const servicios = [
  {
    numero: "01",
    nombre: "Numerología Esencial",
    precio: "$400",
    descripcion: "Estudio numerológico personal: camino de vida, números de alma y personalidad.",
  },
  {
    numero: "02",
    nombre: "Carta Esencial",
    precio: "$450",
    descripcion: "Carta natal escrita de 15 a 20 páginas: Sol, Luna, Ascendente, planetas, casas y aspectos principales.",
  },
  {
    numero: "03",
    nombre: "Consulta en vivo",
    precio: "$500",
    descripcion: "Sesión de 60 minutos, sin informe escrito.",
  },
  {
    numero: "04",
    nombre: "Carta Completa",
    precio: "$800",
    descripcion: "Informe de 30+ páginas con nodos lunares, Quirón y análisis de aspectos a fondo.",
  },
  {
    numero: "05",
    nombre: "Carta + Sesión",
    precio: "$1,200",
    descripcion: "Carta Completa y videollamada de 45 a 60 minutos para explicarla y resolver dudas.",
  },
  {
    numero: "06",
    nombre: "Paquete Integral",
    precio: "$1,800",
    descripcion: "Carta Completa, tránsitos del año, sesión de 60 minutos y seguimiento a los 3 meses.",
  },
];
---

<section id="servicios" class="relative py-24 px-6">
  <div class="max-w-5xl mx-auto">
    {/* Encabezado */}
    <div class="text-center mb-16">
      {/* Eyebrow */}
      <p class="font-sans text-xs tracking-wide-elegant text-dorado/80 uppercase mb-6">
        Servicios
      </p>

      {/* Título */}
      <h2 class="font-serif text-4xl md:text-5xl text-dorado tracking-elegant mb-6">
        Cartas y consultas
      </h2>

      {/* Divider decorativo */}
      <div class="flex items-center justify-center gap-3 mb-6">
        <div class="w-16 h-px bg-dorado/50"></div>
        <div class="w-1.5 h-1.5 rounded-full bg-dorado"></div>
        <div class="w-16 h-px bg-dorado/50"></div>
      </div>

      {/* Descripción */}
      <p class="font-sans text-base text-crema/70 max-w-2xl mx-auto leading-relaxed">
        Cada lectura está hecha a mano, con dedicación y más de 40 años de
        experiencia interpretando el cielo.
      </p>
    </div>

    {/* Lista de servicios */}
    <div class="flex flex-col gap-0 border-t border-dorado/20">
      {servicios.map((servicio) => (
        <div class="group grid grid-cols-12 gap-4 md:gap-8 py-8 border-b border-dorado/20 hover:bg-dorado/5 transition-colors duration-300 px-4 md:px-6">
          {/* Número */}
          <div class="col-span-12 md:col-span-1">
            <span class="font-sans text-xs tracking-wide-elegant text-dorado/50 uppercase">
              {servicio.numero}
            </span>
          </div>

          {/* Nombre y descripción */}
          <div class="col-span-12 md:col-span-8">
            <h3 class="font-serif text-2xl md:text-3xl text-dorado mb-3 group-hover:text-dorado-light transition-colors">
              {servicio.nombre}
            </h3>
            <p class="font-sans text-sm text-crema/60 leading-relaxed max-w-2xl">
              {servicio.descripcion}
            </p>
          </div>

          {/* Precio */}
          <div class="col-span-12 md:col-span-3 flex md:justify-end items-start">
            <div class="text-right">
              <div class="font-serif text-3xl md:text-4xl text-dorado">
                {servicio.precio}
              </div>
              <div class="font-sans text-xs tracking-wide-elegant text-crema/50 uppercase mt-1">
                MXN
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    {/* Nota al final */}
    <div class="text-center mt-12">
      <p class="font-sans text-sm text-crema/60 italic">
        Reserva con 50% de anticipo por transferencia.
      </p>
    </div>

    {/* CTA */}
    <div class="text-center mt-10">
      <a
        href="https://wa.me/526861614063?text=Hola%20AstroCarlZ%2C%20me%20interesa%20agendar%20una%20consulta."
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block px-8 py-4 bg-dorado text-marina font-sans text-sm tracking-wide-elegant uppercase font-medium hover:bg-dorado-light transition-colors duration-300"
      >
        Agendar consulta
      </a>
    </div>
  </div>
</section>